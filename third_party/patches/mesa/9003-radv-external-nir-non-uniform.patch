From 253888824198e9c96999567220b4f02a7e9d1d9f Mon Sep 17 00:00:00 2001
From: Stela contributor <contributor@example.invalid>
Date: Tue, 17 Nov 2026 10:49:06 +0100
Subject: [PATCH] radv: take given NIR's texture and image accesses as
 non-uniform until shown uniform

Metal lets every lane of a wave reach its own texture, sampler or image
through an argument buffer, which Vulkan allows only for accesses qualified
non-uniform. RADV waterfalls only accesses flagged ACCESS_NON_UNIFORM or
texture_non_uniform, so a NIR shader given in
VkPipelineShaderStageNirCreateInfoMESA reads every lane's descriptor from
the first lane's. Flag every such access; nir_opt_non_uniform_access, which
RADV's pipeline runs, clears the flag wherever divergence analysis proves
the handle uniform.
---
 src/amd/vulkan/radv_shader.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index 1523756..6892d03 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -470,6 +470,29 @@ ycbcr_conversion_lookup(const void *data, uint32_t set, uint32_t binding, uint32
    }
 }
 
+/* Metal lets every lane of a wave reach its own texture, sampler or image
+ * through an argument buffer, as Vulkan does only for non-uniform-qualified
+ * accesses: each access of NIR given to RADV is taken as non-uniform, and
+ * nir_opt_non_uniform_access keeps the flag only where the handle diverges.
+ */
+static bool
+flag_non_uniform(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type == nir_instr_type_tex) {
+      nir_tex_instr *tex = nir_instr_as_tex(instr);
+      tex->texture_non_uniform = true;
+      tex->sampler_non_uniform = true;
+      return true;
+   }
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+   if (!nir_intrinsic_has_image_dim(intrin) || !nir_intrinsic_has_access(intrin))
+      return false;
+   nir_intrinsic_set_access(intrin, nir_intrinsic_access(intrin) | ACCESS_NON_UNIFORM);
+   return true;
+}
+
 nir_shader *
 radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct radv_shader_stage *stage,
                          const struct radv_spirv_to_nir_options *options, bool is_internal)
@@ -502,6 +525,7 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
        * in the normalized form, and doubles only as the options lower them. */
       NIR_PASS(_, nir, nir_lower_doubles, NULL, nir->options->lower_doubles_options);
       NIR_PASS(_, nir, nir_normalize_sin_cos);
+      NIR_PASS(_, nir, nir_shader_instructions_pass, flag_non_uniform, nir_metadata_all, NULL);
 
       assert(exec_list_length(&nir->functions) == 1);
       radv_shader_choose_subgroup_size(compiler_info, nir, &stage->key, 0);
-- 
