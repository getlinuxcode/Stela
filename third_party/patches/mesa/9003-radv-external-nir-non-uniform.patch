From f004130231b36e7f2925436034954fc7d4917700 Mon Sep 17 00:00:00 2001
From: Stela contributor <contributor@example.invalid>
Date: Mon, 16 Nov 2026 19:17:25 +0100
Subject: [PATCH] radv: take external NIR's texture and image accesses as
 non-uniform until shown uniform

---
 src/amd/vulkan/radv_shader.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index 0c3cea5..c11e45b 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -473,6 +473,29 @@ ycbcr_conversion_lookup(const void *data, uint32_t set, uint32_t binding, uint32
 /* load_global(_constant)_bounded, which ACO does not select: the load when
  * every byte lies below the bound, zero otherwise, as nir_lower_explicit_io
  * guards robust loads. */
+/* Metal lets every lane of a wave reach its own texture, sampler or image
+ * through an argument buffer, as Vulkan does only for non-uniform-qualified
+ * accesses: each access of external NIR is taken as non-uniform, and
+ * nir_opt_non_uniform_access keeps the flag only where the handle diverges.
+ */
+static bool
+flag_non_uniform(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type == nir_instr_type_tex) {
+      nir_tex_instr *tex = nir_instr_as_tex(instr);
+      tex->texture_non_uniform = true;
+      tex->sampler_non_uniform = true;
+      return true;
+   }
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+   if (!nir_intrinsic_has_image_dim(intrin) || !nir_intrinsic_has_access(intrin))
+      return false;
+   nir_intrinsic_set_access(intrin, nir_intrinsic_access(intrin) | ACCESS_NON_UNIFORM);
+   return true;
+}
+
 static bool
 lower_bounded_load(nir_builder *b, nir_intrinsic_instr *intrin, void *data)
 {
@@ -546,6 +569,7 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
             NIR_PASS(_, nir, nir_shader_intrinsics_pass, lower_bounded_load, nir_metadata_none, NULL);
          NIR_PASS(_, nir, nir_lower_doubles, NULL, nir->options->lower_doubles_options);
          NIR_PASS(_, nir, nir_normalize_sin_cos);
+         NIR_PASS(_, nir, nir_shader_instructions_pass, flag_non_uniform, nir_metadata_all, NULL);
       }
    } else {
       uint32_t *spirv = (uint32_t *)stage->spirv.data;
