From 4e55f34fe17f2bd513d65ba773c303e6553f1194 Mon Sep 17 00:00:00 2001
From: Stela contributor <contributor@example.invalid>
Date: Mon, 16 Nov 2026 00:56:17 +0100
Subject: [PATCH] radv: take a pipeline stage's NIR from
 VkPipelineShaderStageNirCreateInfoMESA

The common runtime takes a stage that carries no module but this Mesa
internal structure as its NIR (vk_pipeline_shader_stage_to_nir), which
Stela's Metal device hands NVK. RADV initializes its stages itself and
skipped such a stage; take its NIR as RADV's own internal NIR.

Unlike RADV's meta shaders, such NIR has not been through the lowering
RADV's SPIR-V path ends with: lower doubles and normalize sine and cosine
for it, which ACO otherwise refuses (fsin).
---
 src/amd/vulkan/radv_pipeline.c | 10 +++++++++-
 src/amd/vulkan/radv_shader.c   |  7 +++++++
 src/amd/vulkan/radv_shader.h   |  2 ++
 3 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/amd/vulkan/radv_pipeline.c b/src/amd/vulkan/radv_pipeline.c
index c73afe0..714f183 100644
--- a/src/amd/vulkan/radv_pipeline.c
+++ b/src/amd/vulkan/radv_pipeline.c
@@ -191,7 +191,12 @@ radv_pipeline_stage_init(VkPipelineCreateFlags2 pipeline_flags, const VkPipeline
    const VkPipelineShaderStageModuleIdentifierCreateInfoEXT *iinfo =
       vk_find_struct_const(sinfo->pNext, PIPELINE_SHADER_STAGE_MODULE_IDENTIFIER_CREATE_INFO_EXT);
 
-   if (sinfo->module == VK_NULL_HANDLE && !minfo && !iinfo)
+   /* A stage built as NIR by the same Mesa, as the common runtime takes it
+    * (vk_pipeline_shader_stage_to_nir): RADV treats it as its own. */
+   const VkPipelineShaderStageNirCreateInfoMESA *nir_info =
+      vk_find_struct_const(sinfo->pNext, PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA);
+
+   if (sinfo->module == VK_NULL_HANDLE && !minfo && !iinfo && !nir_info)
       return;
 
    memset(out_stage, 0, sizeof(*out_stage));
@@ -215,6 +220,9 @@ radv_pipeline_stage_init(VkPipelineCreateFlags2 pipeline_flags, const VkPipeline
    } else if (minfo) {
       out_stage->spirv.data = (const char *)minfo->pCode;
       out_stage->spirv.size = minfo->codeSize;
+   } else if (nir_info) {
+      out_stage->internal_nir = nir_info->nir;
+      out_stage->external_nir = true;
    }
 
    const VkShaderDescriptorSetAndBindingMappingInfoEXT *mapping =
diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index 312b7c0..626996c 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -490,6 +490,13 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
 
       assert(exec_list_length(&nir->functions) == 1);
       radv_shader_choose_subgroup_size(compiler_info, nir, &stage->key, 0);
+
+      /* NIR another frontend built for this Mesa skipped the lowering the
+       * SPIR-V path ends with, which RADV's own NIR needs none of. */
+      if (stage->external_nir) {
+         NIR_PASS(_, nir, nir_lower_doubles, NULL, nir->options->lower_doubles_options);
+         NIR_PASS(_, nir, nir_normalize_sin_cos);
+      }
    } else {
       uint32_t *spirv = (uint32_t *)stage->spirv.data;
       assert(stage->spirv.size % 4 == 0);
diff --git a/src/amd/vulkan/radv_shader.h b/src/amd/vulkan/radv_shader.h
index 7834777..25f8774 100644
--- a/src/amd/vulkan/radv_shader.h
+++ b/src/amd/vulkan/radv_shader.h
@@ -293,6 +293,8 @@ struct radv_shader_stage {
    nir_shader *nir;
    nir_shader *gs_copy_shader;
    nir_shader *internal_nir; /* meta shaders */
+   /* internal_nir came from VkPipelineShaderStageNirCreateInfoMESA. */
+   bool external_nir;
 
    struct radv_shader_info info;
    struct radv_shader_args args;
-- 
