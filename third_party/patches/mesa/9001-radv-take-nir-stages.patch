From 0d4dddb7ee26e2851f8becda06c7315780bd6d9a Mon Sep 17 00:00:00 2001
From: Stela contributor <contributor@example.invalid>
Date: Mon, 16 Nov 2026 00:56:17 +0100
Subject: [PATCH] radv: take a pipeline stage's NIR from
 VkPipelineShaderStageNirCreateInfoMESA

The common runtime takes a stage that carries no module but this Mesa
internal structure as its NIR (vk_pipeline_shader_stage_to_nir), which
Stela's Metal device hands NVK. RADV initializes its stages itself and
skipped such a stage; take its NIR as RADV's own internal NIR.

Unlike RADV's meta shaders, such NIR has not been through the lowering
RADV's SPIR-V path does: turn the point coordinate and a fragment's
primitive ID into inputs, take load_base_vertex as Vulkan's BaseVertex
(load_first_vertex, as SPIR-V gives it), guard bounded global loads,
which ACO does not select, lower doubles and normalize sine and cosine.
---
 src/amd/vulkan/radv_pipeline.c | 10 +++++-
 src/amd/vulkan/radv_shader.c   | 57 ++++++++++++++++++++++++++++++++++
 src/amd/vulkan/radv_shader.h   |  2 ++
 3 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/src/amd/vulkan/radv_pipeline.c b/src/amd/vulkan/radv_pipeline.c
index c73afe0..714f183 100644
--- a/src/amd/vulkan/radv_pipeline.c
+++ b/src/amd/vulkan/radv_pipeline.c
@@ -191,7 +191,12 @@ radv_pipeline_stage_init(VkPipelineCreateFlags2 pipeline_flags, const VkPipeline
    const VkPipelineShaderStageModuleIdentifierCreateInfoEXT *iinfo =
       vk_find_struct_const(sinfo->pNext, PIPELINE_SHADER_STAGE_MODULE_IDENTIFIER_CREATE_INFO_EXT);
 
-   if (sinfo->module == VK_NULL_HANDLE && !minfo && !iinfo)
+   /* A stage built as NIR by the same Mesa, as the common runtime takes it
+    * (vk_pipeline_shader_stage_to_nir): RADV treats it as its own. */
+   const VkPipelineShaderStageNirCreateInfoMESA *nir_info =
+      vk_find_struct_const(sinfo->pNext, PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA);
+
+   if (sinfo->module == VK_NULL_HANDLE && !minfo && !iinfo && !nir_info)
       return;
 
    memset(out_stage, 0, sizeof(*out_stage));
@@ -215,6 +220,9 @@ radv_pipeline_stage_init(VkPipelineCreateFlags2 pipeline_flags, const VkPipeline
    } else if (minfo) {
       out_stage->spirv.data = (const char *)minfo->pCode;
       out_stage->spirv.size = minfo->codeSize;
+   } else if (nir_info) {
+      out_stage->internal_nir = nir_info->nir;
+      out_stage->external_nir = true;
    }
 
    const VkShaderDescriptorSetAndBindingMappingInfoEXT *mapping =
diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index 312b7c0..0c3cea5 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -470,6 +470,48 @@ ycbcr_conversion_lookup(const void *data, uint32_t set, uint32_t binding, uint32
    }
 }
 
+/* load_global(_constant)_bounded, which ACO does not select: the load when
+ * every byte lies below the bound, zero otherwise, as nir_lower_explicit_io
+ * guards robust loads. */
+static bool
+lower_bounded_load(nir_builder *b, nir_intrinsic_instr *intrin, void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_load_global_bounded &&
+       intrin->intrinsic != nir_intrinsic_load_global_constant_bounded)
+      return false;
+   b->cursor = nir_before_instr(&intrin->instr);
+   const unsigned components = intrin->def.num_components, bit_size = intrin->def.bit_size;
+   const unsigned bytes = components * bit_size / 8;
+   nir_def *base = intrin->src[0].ssa, *offset = intrin->src[1].ssa, *bound = intrin->src[2].ssa;
+   nir_def *inside = nir_iand(b, nir_uge_imm(b, bound, bytes),
+                              nir_uge(b, nir_iadd_imm(b, bound, -(int)bytes), offset));
+   nir_push_if(b, inside);
+   nir_def *address = nir_iadd(b, base, nir_u2u64(b, offset));
+   nir_def *value =
+      intrin->intrinsic == nir_intrinsic_load_global_constant_bounded
+         ? nir_load_global_constant(b, components, bit_size, address,
+                                    .align_mul = nir_intrinsic_align_mul(intrin),
+                                    .align_offset = nir_intrinsic_align_offset(intrin))
+         : nir_load_global(b, components, bit_size, address,
+                           .align_mul = nir_intrinsic_align_mul(intrin),
+                           .align_offset = nir_intrinsic_align_offset(intrin));
+   nir_pop_if(b, NULL);
+   nir_def_replace(&intrin->def, nir_if_phi(b, value, nir_imm_zero(b, components, bit_size)));
+   return true;
+}
+
+/* Vulkan's BaseVertex, which SPIR-V gives RADV as load_first_vertex: NIR's
+ * load_base_vertex has OpenGL's meaning, which RADV does not implement. */
+static bool
+lower_base_vertex(nir_builder *b, nir_intrinsic_instr *intrin, void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_load_base_vertex)
+      return false;
+   b->cursor = nir_before_instr(&intrin->instr);
+   nir_def_replace(&intrin->def, nir_load_first_vertex(b));
+   return true;
+}
+
 nir_shader *
 radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct radv_shader_stage *stage,
                          const struct radv_spirv_to_nir_options *options, bool is_internal)
@@ -490,6 +532,21 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
 
       assert(exec_list_length(&nir->functions) == 1);
       radv_shader_choose_subgroup_size(compiler_info, nir, &stage->key, 0);
+
+      /* NIR another frontend built for this Mesa skipped the lowering the
+       * SPIR-V path ends with, which RADV's own NIR needs none of. */
+      if (stage->external_nir) {
+         const struct nir_lower_sysvals_to_varyings_options sysvals_to_varyings = {
+            .point_coord = true,
+            .primitive_id = nir->info.stage == MESA_SHADER_FRAGMENT,
+         };
+         NIR_PASS(_, nir, nir_lower_sysvals_to_varyings, &sysvals_to_varyings);
+         NIR_PASS(_, nir, nir_shader_intrinsics_pass, lower_base_vertex, nir_metadata_control_flow, NULL);
+         if (!nir->options->has_load_global_bounded)
+            NIR_PASS(_, nir, nir_shader_intrinsics_pass, lower_bounded_load, nir_metadata_none, NULL);
+         NIR_PASS(_, nir, nir_lower_doubles, NULL, nir->options->lower_doubles_options);
+         NIR_PASS(_, nir, nir_normalize_sin_cos);
+      }
    } else {
       uint32_t *spirv = (uint32_t *)stage->spirv.data;
       assert(stage->spirv.size % 4 == 0);
diff --git a/src/amd/vulkan/radv_shader.h b/src/amd/vulkan/radv_shader.h
index 7834777..25f8774 100644
--- a/src/amd/vulkan/radv_shader.h
+++ b/src/amd/vulkan/radv_shader.h
@@ -293,6 +293,8 @@ struct radv_shader_stage {
    nir_shader *nir;
    nir_shader *gs_copy_shader;
    nir_shader *internal_nir; /* meta shaders */
+   /* internal_nir came from VkPipelineShaderStageNirCreateInfoMESA. */
+   bool external_nir;
 
    struct radv_shader_info info;
    struct radv_shader_args args;
-- 
