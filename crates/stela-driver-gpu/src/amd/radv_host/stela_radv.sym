/* What libstela_radv exports: the Vulkan driver's entry points and the AIR
 * compiler service, which share one NIR. */
{
  global:
    vk_icdGetInstanceProcAddr;
    vk_icdNegotiateLoaderICDInterfaceVersion;
    vk_icdGetPhysicalDeviceProcAddr;
    stela_*;
  local:
    *;
};
